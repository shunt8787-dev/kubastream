<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/panel" />
            <stroke android:width="6dp" android:color="#332DF0FF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:top="3dp" android:left="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/panel" />
            <stroke android:width="2dp" android:color="@color/cyan" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
